# Copy to .env (never commit .env) or set these in the hosting dashboard.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Kampala

# PostgreSQL (Neon/Supabase/Render). Leave empty for local SQLite.
# Example: postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/rukomeza?sslmode=require
DATABASE_URL=
DB_SSL_MODE=require
DB_CONN_MAX_AGE=60

# Mock payment gateway (documented in docs/PAYMENTS.md)
PAYMENT_GATEWAY=MOCK
MOCK_GATEWAY_SECRET=replace-with-a-random-webhook-secret
SHIPPING_FEE=0
MAX_ORDER_LINE_QUANTITY=99

# Seed the demo dataset on deploy (set False after marking)
SEED_DEMO=true

# Optional: only for fast local test runs
FAST_TESTS=
